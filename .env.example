# demo = 无外部调用；live = 必须配置下方服务，失败不会回退成演示结果
AI_MODE=demo
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_API_KEY=
TEXT_MODEL=
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=
# 部署 HTTPS 后设为 true
COOKIE_SECURE=false
DATA_DIR=./data
MAX_UPLOAD_MB=200
# 单机只启动一个应用进程；进程内按队列处理长任务
# 独立任务进程部署时Web设false，worker命令：python -m app.worker
RUN_WORKER=true
MAX_PROJECT_JOBS=500
MAX_PROJECT_AUDIO_MB=2048
MAX_JOB_ATTEMPTS=5
# 服务商支持时可选 verbose_json / diarized_json；能力由供应商决定
ASR_RESPONSE_FORMAT=json
# 对外分享二维码及邮件恢复需要实际HTTPS地址
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
